{
  "name": "dev-project-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.17.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "node scripts/setup-local.mjs",
    "db:up": "docker compose up -d --wait postgres",
    "db:stop": "docker compose stop postgres",
    "db:migrate": "node --env-file=.env scripts/migrate.mjs",
    "dev": "npm run build --workspace @dev-project-agent/contracts && node scripts/dev.mjs",
    "build": "npm run build --workspace @dev-project-agent/contracts && npm run build --workspace @dev-project-agent/server && npm run build --workspace @dev-project-agent/web",
    "typecheck": "npm run build --workspace @dev-project-agent/contracts && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:db": "node --env-file=.env scripts/check-database.mjs",
    "start": "node --env-file=.env apps/server/dist/index.js",
    "user:create": "node --env-file=.env --import tsx scripts/manage-user.ts create",
    "user:reset": "node --env-file=.env --import tsx scripts/manage-user.ts reset",
    "test:auth-db": "node --env-file=.env scripts/test-auth.mjs",
    "trello:import": "node --env-file=.env --import tsx scripts/import-trello.ts",
    "test:trello-db": "node --env-file=.env scripts/test-trello.mjs",
    "test:supervision-db": "node --env-file=.env scripts/test-supervision.mjs",
    "test:provider-db": "node --env-file=.env scripts/test-provider.mjs",
    "test:executions-db": "node --env-file=.env scripts/test-executions.mjs",
    "test:proposals-db": "node --env-file=.env scripts/test-proposals.mjs",
    "ai:validate": "node --import tsx scripts/validate-chatgpt.ts",
    "sources:read": "node --env-file=.env --import tsx scripts/read-sources.ts",
    "test:ui": "npm run build && node --env-file=.env --import tsx scripts/test-ui.ts",
    "test:code-db": "node --env-file=.env scripts/test-code-review.mjs",
    "code:inspect": "node --env-file=.env --import tsx scripts/inspect-code.ts",
    "test:renewal-db": "node --env-file=.env scripts/test-renewal.mjs",
    "test:reports-db": "node --env-file=.env scripts/test-reports.mjs",
    "test:operations-db": "node --env-file=.env scripts/test-operations.mjs",
    "test:notifications-db": "node --env-file=.env scripts/test-notifications.mjs",
    "test:ollama-db": "node --env-file=.env scripts/test-ollama.mjs",
    "ollama:validate": "node --env-file=.env --import tsx scripts/validate-ollama.ts",
    "ollama:audit-evidence": "node --import tsx scripts/audit-ollama-evidence.ts",
    "ollama:benchmark": "node --env-file=.env --import tsx scripts/benchmark-ollama.ts",
    "ollama:benchmark-v2": "node --env-file=.env --import tsx scripts/benchmark-v2.ts",
    "workflow:real": "node --env-file=.env --import tsx scripts/test-agent-workflow.ts",
    "test:isolated": "node --env-file=.env scripts/test-isolated.mjs",
    "test:coverage-db": "node --env-file=.env scripts/test-isolated.mjs --coverage",
    "db:backup": "node --env-file=.env scripts/backup-local.mjs --verify",
    "verify:install": "node --env-file=.env scripts/verify-install.mjs",
    "release:package": "node --env-file=.env scripts/package-release.mjs"
  },
  "devDependencies": {
    "@inquirer/prompts": "8.7.3",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "node-pg-migrate": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
