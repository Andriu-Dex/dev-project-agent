# Run npm run setup to generate local credentials without printing them.
POSTGRES_PASSWORD=
APP_DATABASE_PASSWORD=
DATABASE_URL=
APP_DATABASE_URL=
PORT=3100
SESSION_SECRET=
CHATGPT_CREDENTIAL_KEY=
APP_ORIGINS=http://127.0.0.1:5174,http://127.0.0.1:3100
ALLOW_INSECURE_LOCAL_HTTP=true
TRELLO_API_KEY=
TRELLO_TOKEN=
GITHUB_TOKEN=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Real writes require explicit configuration and a separate read/write token.
TRELLO_WRITES_ENABLED=false
TRELLO_WRITE_TOKEN=
GITHUB_WRITES_ENABLED=false
GITHUB_WRITE_TOKEN=

# SMTP uses TLS. With 465 secure defaults true; with 587 STARTTLS is required.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional: SMTP_SECURE=true for 465, false for STARTTLS on 587.
APP_PUBLIC_URL=http://127.0.0.1:5174
# Recipient and automatic notification consent are saved by the manager in the dashboard.
