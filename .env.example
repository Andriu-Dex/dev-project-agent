# Run npm run setup to generate local credentials without printing them.
POSTGRES_PASSWORD=
APP_DATABASE_PASSWORD=
DATABASE_URL=
APP_DATABASE_URL=
PORT=3100
SESSION_SECRET=
CHATGPT_CREDENTIAL_KEY=
APP_ORIGINS=http://127.0.0.1:5174,http://127.0.0.1:3100
ALLOW_INSECURE_LOCAL_HTTP=true
TRELLO_API_KEY=
TRELLO_TOKEN=
GITHUB_TOKEN=

# Real writes require explicit configuration and a separate read/write token.
